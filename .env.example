# Copier vers .env (jamais commité, R10/R76) puis remplir. Valeurs vides = désactivé.
# Sans DISCORD_WEBHOOK_URL, les runs locaux n'envoient rien sur Discord (silencieux).
# Discord : paramètres du salon -> Intégrations -> Webhooks -> Nouveau webhook -> copier l'URL.
DISCORD_WEBHOOK_URL=
# GitHub : token lecture multi-repos (surveillance, agent PR en dry-run).
GH_TOKEN=
# GitHub : token élargi optionnel pour les repos PRIVES (sinon 15/20 couverts).
KURO_PRIVATE_TOKEN=
# Cerveaux LLM : DeepSeek d'abord conseillé (le plus fiable constate), OpenRouter ensuite.
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
# Vacances : 1 = tout Kuro local en lecture seule (digest seul).
KURO_VACANCES=
# Any.do (optionnel) : bearer OAuth pour --pull/--push (sinon --export seul).
ANYDO_TOKEN=
# Discord Bot (optionnel) : creer categories/salons + corriger topics (kuro_discord.py sync).
# https://discord.com/developers/applications -> Bot -> Reset Token -> Message Content Intent ON.
DISCORD_BOT_TOKEN=
# Discord : ID du serveur (clic droit serveur -> Copier l'identifiant) pour sync.
DISCORD_GUILD_ID=
# X par compte-projet (optionnel, 1 jeu par compte — ex: Helium) : developer.x.com
# projet+app -> User authentication -> Read+Write. Jamais commite.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# X annexe Helium (optionnel) : meme procedure sur le compte Helium.
X_HELIUM_API_KEY=
X_HELIUM_API_SECRET=
X_HELIUM_ACCESS_TOKEN=
X_HELIUM_ACCESS_SECRET=
# X pay-per-use (depuis 02/2026, plus de free tier) : poster coute ~0,015$/post
# sans lien. basic|pro|paid = poste ; free (defaut) = drafts + Discord seuls.
X_PLAN=free
# Buffer gratuit (3 canaux, 10 posts en file/canal) : Settings > API -> cle,
# connecter les profils X, regler le planning d'envoi. X_VIA=buffer pour poster via Buffer.
BUFFER_API_KEY=
BUFFER_CHANNEL_HUB=
BUFFER_CHANNEL_HELIUM=
X_VIA=x
# Kit newsletter (gratuit 0-10k, paid inclus) : Settings > API -> cle.
KIT_API_KEY=
